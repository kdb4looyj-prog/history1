    "index.html": {
      "settings": {
        "main": true,
        "title": "History of Ad Designer & photograph",
        "meta_descr": "Explore the history of the ad designer and photography—a journey born from the printing press, revolutionized by the camera, and defined by their powerful convergence in mass visual communication.",
        "header_custom": "",
        "footer_custom": "",
